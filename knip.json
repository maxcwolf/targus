{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/**/*.test.mjs"],
      "project": ["scripts/**/*.mjs", "*.{js,cjs}"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    },
    "packages/react-native": {
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "e2e": {
      "project": ["*.ts"]
    }
  }
}
