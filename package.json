{
  "name": "targus",
  "private": true,
  "type": "module",
  "description": "Visual review for React Native on-device Storybook.",
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn depcruise && yarn knip && yarn test",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise packages apps e2e scripts --validate .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "yarn workspaces foreach --all --parallel --exclude targus run test && yarn test:scripts",
    "test:scripts": "node --test --test-reporter=spec \"scripts/**/*.test.mjs\"",
    "e2e": "yarn workspace @targus/e2e run e2e",
    "dev:local": "yarn workspace @targus/e2e run dev:local",
    "playwright": "yarn workspace @targus/e2e exec playwright",
    "new:adapter": "node scripts/new-adapter.mjs",
    "new:route": "node scripts/new-route.mjs",
    "changeset": "changeset",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
