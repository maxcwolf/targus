{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    // Workspace packages export "development" -> src/index.ts, so type-checking and project
    // references see source. Built consumers (Node, npm) never set it and get dist (ADR 0010).
    "customConditions": ["development"],
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    // Relative imports name the real file (`./x.ts`). Projects that emit JavaScript (each
    // package's tsconfig.lib.json) also set rewriteRelativeImportExtensions, so `dist/` gets
    // `.js` paths and stays valid for Node (ADR 0017).
    "allowImportingTsExtensions": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "${configDir}/.tsbuild",
    "rootDir": "${configDir}",
    "tsBuildInfoFile": "${configDir}/.tsbuild/tsconfig.tsbuildinfo",
    "types": []
  }
}
